# Salin file ini menjadi .env untuk pengembangan lokal.
DJANGO_SECRET_KEY=django-insecure-local-development-key-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# SQLite cukup untuk pengembangan lokal.
DATABASE_URL=sqlite:///db.sqlite3

# Contoh produksi:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=ganti-dengan-secret-key-yang-kuat
# DJANGO_ALLOWED_HOSTS=faris-salman-sibekas.pws.cs.ui.ac.id
# DJANGO_CSRF_TRUSTED_ORIGINS=https://faris-salman-sibekas.pws.cs.ui.ac.id
# DATABASE_URL=postgresql://user:password@host:5432/database
