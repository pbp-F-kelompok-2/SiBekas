# Salin file ini menjadi .env untuk pengembangan lokal.
DJANGO_SECRET_KEY=django-insecure-local-development-key-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# SQLite cukup untuk pengembangan lokal.
DATABASE_URL=sqlite:///db.sqlite3

# Contoh produksi:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=ganti-dengan-secret-key-yang-kuat
# DJANGO_ALLOWED_HOSTS=faris-salman-sibekas.pws.cs.ui.ac.id
# DJANGO_CSRF_TRUSTED_ORIGINS=https://faris-salman-sibekas.pws.cs.ui.ac.id
# DATABASE_URL=postgresql://user:password@host:5432/database

# Shipping Cost API RajaOngkir / Komerce (opsional untuk pengambilan di kampus).
RAJAONGKIR_API_KEY=
# ID subdistrict titik pengumpulan kampus, dari destination/domestic-destination.
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_COURIERS=jne:jnt:sicepat
# Simulasi akademik: tidak memindahkan uang. Default mengikuti DJANGO_DEBUG.
ORDER_ENABLE_DEMO_PAYMENT=True
# Opsional: isi katalog awal saat release jika belum mencapai 50 produk.
# Produk yang sudah ada tidak ditimpa. Nonaktifkan kembali setelah data terisi.
DJANGO_SEED_INITIAL_PRODUCTS=False

# Opsional: buat akun petugas pada release melalui environment privat PWS.
# Akun yang sudah ada tidak diubah; tidak ada hak superuser yang diberikan.
ORDER_STAFF_USERNAME=
ORDER_STAFF_EMAIL=
ORDER_STAFF_PASSWORD=

# SMTP untuk reset password (isi melalui environment hosting, jangan commit secret).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
